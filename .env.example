# ==============================================================================
# Upside-Down 2.0: AI Hackathon Mission Control — Environment Configuration
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
UD_COORDINATOR_PORT=4000
UD_HOST=127.0.0.1

# SQLite Database File Location (Defaults to .local/coordinator.db)
UD_COORDINATOR_DB=./coordinator.db

# CORS Allowed Origins (Comma-separated for web frontend)
UD_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI Provider Configuration
# If GEMINI_API_KEY or OPENAI_API_KEY is not set, the platform operates in
# deterministic, zero-cost [DEMO MODE] returning robust heuristic responses.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Configuration (for web/ directory)
# VITE_API_URL=http://127.0.0.1:4000
