{
  "name": "@upside-down/client-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.20.0" },
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:baseline": "node scripts/prepare-baseline.ts && tsc --noEmit -p tsconfig.baseline.json"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.2"
  }
}
